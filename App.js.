
import React, { useState } from 'react';

import {
  View,
  Text,
  TextInput,
  Button,
  StyleSheet,
  Alert,
  Keyboard
} from 'react-native';

export default function App() {

  const [peso, setPeso] = useState('');
  const [resultado, setResultado] = useState(null);

  function calcularAgua() {

    Keyboard.dismiss();

    if (peso.trim() === '') {
      Alert.alert(
        'Atenção',
        'Por favor, informe seu peso.'
      );
      setResultado(null);
      return;
    }

  
    const pesoNumerico = Number(
      peso.trim().replace(',', '.')
    );


    if (!Number.isFinite(pesoNumerico) || pesoNumerico <= 0) {
      Alert.alert(
        'Valor inválido',
        'Informe um peso maior que zero.'
      );
      setResultado(null);
      return;
    }

    const agua = (pesoNumerico * 35) / 1000;
    setResultado(agua.toFixed(2));
  }

  return (

    <View style={styles.container}>

      <Text style={styles.titulo}>
        Calculadora de Hidratação
      </Text>

      <Text style={styles.subtitulo}>
        Descubra sua estimativa de consumo diário de água!
      </Text>

      <View style={styles.card}>

        <Text style={styles.label}>
          Informe seu peso (kg):
        </Text>

        <TextInput
          style={styles.input}
          placeholder="Exemplo: 70"
          placeholderTextColor="#999"
          keyboardType="decimal-pad"
          value={peso}
          onChangeText={(valor) => {
            setPeso(valor);
            setResultado(null);
          }}
        />

        <View style={styles.botao}>
          <Button
            title="Calcular"
            color="#087E8B"
            onPress={calcularAgua}
          />
        </View>

        {resultado !== null && (

          <View style={styles.resultado}>

            <Text style={styles.textoResultado}>
              Seu consumo estimado é:
            </Text>

            <Text style={styles.valor}>
              {resultado.replace('.', ',')} litros
            </Text>

            <Text style={styles.detalhe}>
              de água por dia
            </Text>

          </View>

        )}

      </View>

      <Text style={styles.rodape}>
        Cálculo baseado em 35 mL por kg de peso.
      </Text>

    </View>

  );
}

